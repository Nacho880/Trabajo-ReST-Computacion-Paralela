# =============================================================================
# .env.example — Copiar a .env (raíz del proyecto) y ajustar valores
# según su entorno.
#
# El proyecto carga `.env` automáticamente al importar `config.py`
# (mediante `python-dotenv`), así que basta con tener el archivo
# `.env` junto a este README para que `uvicorn app.main:app --reload`
# lea estas variables sin necesidad de exportarlas en la terminal.
# Una variable ya exportada en el shell tiene prioridad sobre el valor
# de `.env`.
#
# El proyecto usa PostgreSQL estándar: cualquier instancia (local,
# Docker, un servidor propio o un proveedor administrado) sirve, siempre
# que exponga una cadena de conexión libpq válida. No se requiere ningún
# proveedor en particular.
# =============================================================================

# Ruta del CSV que la API REST (app/main.py) carga automáticamente al
# iniciar, sin intervención manual. Si no se define, se usa
# "data/ventas_completas.csv" (relativa a la raíz del proyecto).
CPYD_CSV_PATH=data/ventas_completas.csv

# URL de descarga DIRECTA del CSV (ej. un link de Dropbox con `dl=1` al
# final), usada solo si CPYD_CSV_PATH no existe localmente al iniciar la
# API. Si se deja vacía y el archivo local no existe, la API falla al
# iniciar con un error explícito en vez de arrancar sin datos.
CPYD_CSV_DOWNLOAD_URL=https://www.dropbox.com/scl/fi/sn866nsa70sv71n32k7lk/ventas_completas.csv?rlkey=r30sk0j0xsexltvwr5e31c88s&st=2mhqywur&dl=1

# Cadena de conexión a PostgreSQL (cualquier instancia compatible:
# local, Docker, on-premise o administrada), usada por la arquitectura
# de dos pasadas para la ingesta (COPY masivo) y por la API para
# consultar /v1/estadisticas/ventas directamente vía SQL, sin mantener
# un DataFrame en memoria. Formato estándar libpq. NO incluir
# credenciales reales en este archivo (solo va como ejemplo al
# repositorio); las credenciales reales van únicamente en el .env local
# de cada quien, que nunca se sube (ver .gitignore).
CPYD_DATABASE_URL=postgresql://usuario:password@host:5432/base_datos

# Cadena de conexión a una base PostgreSQL de PRUEBAS. Solo la usan los
# tests de integración (`pytest -m integration`), que se saltan
# automáticamente si esta variable no está definida — la suite completa
# corre sin PostgreSQL instalado.
CPYD_TEST_DATABASE_URL=

# Si "true" (por defecto), crea los índices secundarios de `ventas`
# (fecha, genero, canal, local, sku, codigo_cliente) durante `ensure_schema`.
# Para cargas extremadamente grandes puede convenir ponerlo en "false" y
# crear los índices manualmente después de la ingesta, ya que cada índice
# adicional aumenta el espacio en disco requerido. Ver sql/ddl.sql.
CPYD_CREATE_INDEXES=true

# Si "true" (por defecto), calcula la variable derivada FRECUENCIA_COMPRA
# (requiere un GROUP BY por CODIGO_CLIENTE sobre todo el dataset). Para
# archivos muy grandes esta operación puede ser costosa; puede
# desactivarse con "false" para acelerar la carga inicial y calcularse
# después de forma independiente. Ver sección "Feature engineering
# opcional" del README.
CPYD_ENABLE_FEATURE_ENGINEERING=true
